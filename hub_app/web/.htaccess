<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Serveer bestaande bestanden en directories direct (bijv. main.dart.js, favicon.png)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Leid alle overige paden (zoals /login, /register, /dashboard) door naar index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Cache-control: voorkom dat browsers verouderde versies van index.html cachen na een deploy
<Files "index.html">
  FileETag None
  Header unset ETag
  Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
</Files>
